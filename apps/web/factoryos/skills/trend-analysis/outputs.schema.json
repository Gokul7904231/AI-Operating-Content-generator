{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TrendAnalysisOutput",
  "type": "object",
  "properties": {
    "selectedTopic": { "type": "string" },
    "trendScore": { "type": "number" },
    "noveltyScore": { "type": "number" },
    "evidenceCitations": { "type": "array", "items": { "type": "string" } },
