{
  "id": "worker-routing",
  "version": "1.0.0",
  "name": "Role-Isolated Worker Routing",
  "description": "Enforces strict server-authoritative routing between Azure GPU and GitHub Actions workers.",
  "author": "Overseer Core",
  "lifecycleState": "PROMOTED",
  "targetCapabilities": ["worker_routing"],
  "requiredTools": ["get_worker_pool_health", "claim_worker_slot"],
  "requiredPermissions": ["workers:route"],
  "triggerConditions": {
    "taskTypes": ["RENDER_DISPATCH", "WORKER_SELECT"]
  },
  "safetyBoundaries": {
    "maxRiskLevel": "MEDIUM",
    "isolationRequired": true,
    "humanApprovalRequired": false
  },
  "executionSequence": [
    { "stepIndex": 1, "name": "Verify Role", "toolOrAgent": "worker_routing_gate", "deterministic": true },
    { "stepIndex": 2, "name": "Check Health", "toolOrAgent": "get_worker_pool_health", "deterministic": true }
  ],
  "decisionRules": [
    { "condition": "userRole == 'VIEWER' || userRole == 'EDITOR'", "action": "ROUTE_TO_GITHUB_ACTIONS" },
    { "condition": "userRole == 'ADMIN' || userRole == 'OWNER'", "action": "ROUTE_TO_AZURE" }
  ],
  "evaluationProfile": {
    "isCritical": true,
    "minSkillLift": 0.05,
    "minPassAtK": 0.99,
    "tier1Strict": true,
    "tier2EmbeddingDedup": true,
    "tier3AgentEval": true
  },
  "createdAt": "2026-08-21T00:00:00.000Z",
  "updatedAt": "2026-08-21T00:00:00.000Z"
}
