{
  "name": "factoryos-rendering-cost-guardrail-policy",
  "properties": {
    "displayName": "FactoryOS Rendering Plane FinOps SKU & Resource Policy",
    "description": "Restricts VM SKUs to approved B-series burstable CPU VMs, denies GPU allocation, and denies public IP creation.",
    "mode": "All",
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Compute/virtualMachines"
          },
          {
            "not": {
              "field": "Microsoft.Compute/virtualMachines/sku.name",
              "in": [
                "Standard_B2s_v2",
                "Standard_B4ls_v2",
                "Standard_B4s_v2"
              ]
            }
          }
        ]
      },
      "then": {
        "effect": "deny"
      }
    }
  }
}
