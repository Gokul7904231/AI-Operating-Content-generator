  ],
  "decisionRules": [
    { "condition": "visibility == 'PUBLIC' && isApproved != true", "action": "HALT_FOR_APPROVAL" }
  ],
  "evaluationProfile": {
    "isCritical": true,
    "minSkillLift": 0.05,
    "minPassAtK": 0.99,
    "tier1Strict": true,
    "tier2EmbeddingDedup": true,
