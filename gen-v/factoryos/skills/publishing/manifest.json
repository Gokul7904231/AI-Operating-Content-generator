  "name": "Governed Video Publishing",
  "description": "Publishes shorts to social channels with mandatory approval gate for public visibility.",
  "author": "Overseer Core",
  "lifecycleState": "PROMOTED",
  "targetCapabilities": ["youtube_publish", "social_publish"],
