# FactoryOS Floor 07 — Environment Configuration
# Copy this file to .env and fill in your values.

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=floor07
APP_VERSION=0.1.0
DEBUG=false
GUARDIAN_VERSION=0.1.0

# ─── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://floor07:floor07secret@postgres:5432/floor07
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_POLICY_TTL_SECONDS=3600
REDIS_CERTIFICATE_TTL_SECONDS=300

# ─── Certificate signing ───────────────────────────────────────────────────────
# A hex-encoded 32-byte secret key used for HMAC-SHA256 certificate signing.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SIGNING_SECRET_KEY=change_me_in_production_generate_a_real_secret_key_here

# ─── Policy ───────────────────────────────────────────────────────────────────
POLICY_DATA_DIR=./data/policies

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── Risk thresholds ──────────────────────────────────────────────────────────
RISK_LOW_THRESHOLD=0.25
RISK_MEDIUM_THRESHOLD=0.55
RISK_HIGH_THRESHOLD=0.80
