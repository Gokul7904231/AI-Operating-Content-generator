[Unit]
Description=FactoryOS Azure Admin Render Worker Daemon
After=network.target

[Service]
Type=simple
User=azureuser
WorkingDirectory=/opt/factoryos/vps-rendering-engine
EnvironmentFile=/opt/factoryos/vps-rendering-engine/.env
ExecStart=/usr/bin/python3 /opt/factoryos/vps-rendering-engine/worker_daemon.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=factoryos-admin-render-worker

[Install]
WantedBy=multi-user.target
